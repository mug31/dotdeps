{
  // Waybar: include modul tambahan
  "include": ["~/.config/waybar/modules.jsonc", "~/.config/waybar/modul-hilang.jsonc"],
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["pulseaudio", "custom/weather", "custom/power"],

  "pulseaudio": {
    "format": "{volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout-fiktif"
  }
}
